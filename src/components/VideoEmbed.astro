---
interface Props {
  title: string;
  description?: string;
  provider: 'youtube' | 'vimeo';
  id: string;
}

const { title, description, provider, id } = Astro.props;

const embed =
  provider === 'youtube'
    ? `https://www.youtube-nocookie.com/embed/${id}?rel=0`
    : `https://player.vimeo.com/video/${id}?dnt=1`;
---

<article class="video">
  <div class="frame">
    {
      id ? (
        <iframe
          src={embed}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      ) : (
        <div class="placeholder" role="img" aria-label={`${title}: video coming soon`}>
          <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
            <circle cx="12" cy="12" r="11" fill="none" stroke="currentColor" stroke-width="1.5" />
            <path d="M10 8l6 4-6 4z" fill="currentColor" />
          </svg>
          <span>Coming soon</span>
        </div>
      )
    }
  </div>
  <h3>{title}</h3>
  {description && <p>{description}</p>}
</article>

<style>
  .frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface);
    margin-bottom: 1rem;
  }

  iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    color: var(--white);
    background:
      radial-gradient(circle at 30% 30%, rgba(200, 16, 46, 0.45), transparent 55%),
      linear-gradient(135deg, #1a1a1a, #050505);
    border: 1px solid var(--line);
  }

  .placeholder span {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  h3 {
    margin-bottom: 0.3em;
  }

  p {
    color: var(--muted);
    margin: 0;
  }
</style>
