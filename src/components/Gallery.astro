---
import { Image, getImage } from 'astro:assets';
import type { GalleryPhoto } from '../lib/galleries';

interface Props {
  photos: GalleryPhoto[];
  label: string;
}

const { photos, label } = Astro.props;

// Full screen versions for the lightbox: optimized WebP at a few large widths.
const full = await Promise.all(
  photos.map((p) =>
    getImage({
      src: p.src,
      format: 'webp',
      width: Math.min(1600, p.src.width),
      widths: [1080, 1600].filter((w) => w < Math.min(2400, p.src.width)).concat(Math.min(2400, p.src.width)),
      quality: 82,
    }),
  ),
);
---

<div class="gallery" data-gallery>
  <ul class="grid" aria-label={`${label} photos`}>
    {
      photos.map((photo, i) => (
        <li>
          <a
            href={full[i].src}
            class="tile"
            data-index={i}
            data-srcset={full[i].srcSet.attribute}
            data-alt={photo.alt}
            aria-label={`View full screen: ${photo.alt}`}
          >
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 640, 960, 1280]}
              sizes="(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw"
              format="webp"
              quality={78}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={`${label} photo viewer`}>
    <figure>
      <img alt="" sizes="100vw" decoding="async" />
      <figcaption class="counter" aria-live="polite"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-close aria-label="Close viewer">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" stroke="currentColor" stroke-width="2.5" fill="none">
        <path d="M5 5l14 14M19 5L5 19"></path>
      </svg>
    </button>
    <button type="button" class="lb-btn lb-prev" data-prev aria-label="Previous photo">
      <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" stroke="currentColor" stroke-width="2.5" fill="none">
        <path d="M15 4l-8 8 8 8"></path>
      </svg>
    </button>
    <button type="button" class="lb-btn lb-next" data-next aria-label="Next photo">
      <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" stroke="currentColor" stroke-width="2.5" fill="none">
        <path d="M9 4l8 8-8 8"></path>
      </svg>
    </button>
  </dialog>
</div>

<style>
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 1;
    column-gap: 0.75rem;
  }

  .grid li {
    break-inside: avoid;
    margin-bottom: 0.75rem;
  }

  .tile {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--surface);
  }

  .tile :global(img) {
    width: 100%;
    transition:
      transform 0.4s ease,
      opacity 0.3s ease;
  }

  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0 solid var(--red);
    transition: border-width 0.15s ease;
    pointer-events: none;
  }

  .tile:hover::after,
  .tile:focus-visible::after {
    border-width: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tile:hover :global(img) {
      transform: scale(1.03);
    }
  }

  @media (min-width: 640px) {
    .grid {
      columns: 2;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      columns: 3;
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(0, 0, 0, 0.97);
    color: var(--white);
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: #000;
  }

  .lightbox[open] {
    display: grid;
    place-items: center;
  }

  figure {
    margin: 0;
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding: 4rem 0.5rem 1rem;
  }

  figure img {
    max-width: 100%;
    max-height: calc(100dvh - 7rem);
    width: auto;
    height: auto;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
  }

  .counter {
    padding-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--muted);
  }

  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid transparent;
    color: var(--white);
    cursor: pointer;
  }

  .lb-btn:hover {
    background: var(--red);
  }

  .lb-close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-prev {
    left: 0.5rem;
  }

  .lb-next {
    right: 0.5rem;
  }

  @media (max-width: 639px) {
    /* On phones, swipe to navigate and keep arrows out of the way at the bottom. */
    .lb-prev,
    .lb-next {
      top: auto;
      bottom: 0.5rem;
      transform: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const tiles = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('.tile'));
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog');
    if (!dialog || !tiles.length || typeof dialog.showModal !== 'function') return;

    const img = dialog.querySelector('img')!;
    const counter = dialog.querySelector('.counter')!;
    let index = 0;
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + tiles.length) % tiles.length;
      const tile = tiles[index];
      img.removeAttribute('srcset');
      img.src = tile.href;
      if (tile.dataset.srcset) img.srcset = tile.dataset.srcset;
      img.alt = tile.dataset.alt ?? '';
      counter.textContent = `${index + 1} / ${tiles.length}`;
      // Warm the cache for the next photo so swiping feels instant.
      const next = tiles[(index + 1) % tiles.length];
      const pre = new Image();
      pre.sizes = '100vw';
      if (next.dataset.srcset) pre.srcset = next.dataset.srcset;
      pre.src = next.href;
    };

    tiles.forEach((tile, i) => {
      tile.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        opener = tile;
        show(i);
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
      });
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });

    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));

    // Click on the dark area around the photo closes the viewer.
    dialog.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dialog || t.tagName === 'FIGURE') dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });

    let startX = 0;
    let startY = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        startY = e.touches[0].clientY;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        const dy = e.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
        else if (dy > 90 && Math.abs(dy) > Math.abs(dx)) dialog.close();
      },
      { passive: true },
    );
  });
</script>
