---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page could not be found." noindex>
  <section class="container section">
    <p class="eyebrow">404</p>
    <h1>Missed the shot</h1>
    <p class="lead">The page you are looking for does not exist or has moved.</p>
    <div class="btn-row">
      <a class="btn" href="/">Back Home</a>
      <a class="btn btn--ghost" href="/galleries/">View Galleries</a>
    </div>
  </section>
</BaseLayout>
