---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCta from '../components/BookCta.astro';
import eric from '../assets/about/eric.jpg';
import { site } from '../data/site';

const stats = [
  { value: '8+', label: 'Years of photography experience' },
  { value: '500K+', label: 'Instagram impressions on one Atlanta Vibe highlight' },
  { value: '3', label: 'Pro sports teams: Stripers, Slammers, and Atlanta Vibe' },
];

const credits = [
  { org: 'Northern Star Media', role: 'Photo Editor, previously Senior Photojournalist' },
  { org: 'Gwinnett Stripers', role: 'Game broadcast direction and social content' },
  { org: 'Joliet Slammers', role: 'Game broadcast direction and social content' },
  { org: 'Atlanta Vibe', role: 'Highlight video with 500K+ Instagram impressions' },
  { org: 'Northern Illinois University', role: 'Media Studies' },
];
---

<BaseLayout
  title="About Eric McGill | DeKalb Photographer and Videographer"
  description="Meet Eric McGill, the DeKalb, Illinois photographer, videographer, and editor behind EricMcMedia. Photo Editor at Northern Star Media, serving Chicago and the Midwest."
>
  <section class="container about">
    <div class="photo">
      <Image
        src={eric}
        alt="Eric McGill smiling in front of a red backdrop, holding a camera rig with a shotgun microphone"
        widths={[400, 640, 900, 1080]}
        sizes="(min-width: 900px) 40vw, 100vw"
        format="webp"
        quality={82}
        loading="eager"
      />
    </div>
    <div class="copy">
      <p class="eyebrow">About</p>
      <h1>Eric McGill</h1>
      <p class="role">Photographer &bull; Videographer &bull; Editor</p>
      <p>
        Eric McGill is a photographer, videographer, and editor based in DeKalb, Illinois with over 8 years of
        photography experience. He's currently the Photo Editor at <strong>Northern Star Media</strong>, where he
        oversees photo and story formatting across print and digital. He started there as a Senior Photojournalist,
        covering news, sports, and features on tight deadlines.
      </p>
      <p>
        A Media Studies student at Northern Illinois University, Eric has also worked in sports media, directing game
        broadcasts and producing social content for the <strong>Gwinnett Stripers</strong> and the <strong
          >Joliet Slammers</strong
        >. One of his highlight videos for Atlanta Vibe drew over <strong>500K impressions</strong> on Instagram.
      </p>
      <p>
        Whether he's behind the camera or in the edit, Eric focuses on capturing the moment and telling each subject's
        story.
      </p>
      <div class="btn-row">
        <a class="btn" href="/contact/">Book a Session</a>
        <a class="btn btn--ghost" href={site.instagram.url} rel="me noopener" target="_blank">
          Follow {site.instagram.handle}<span class="sr-only"> on Instagram (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--light" aria-labelledby="creds-heading">
    <div class="container">
      <p class="eyebrow">Credentials</p>
      <h2 id="creds-heading">Newsroom speed. Broadcast polish.</h2>
      <dl class="stats">
        {
          stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="credits">
        {
          credits.map((c) => (
            <li>
              <span class="org">{c.org}</span>
              <span class="credit-role">{c.role}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BookCta />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  .photo {
    position: relative;
    max-width: 32rem;
  }

  .photo::before {
    content: '';
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    border: 6px solid var(--red);
  }

  .photo :global(img) {
    position: relative;
    width: 100%;
  }

  .role {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red-text);
    margin-bottom: 1.5rem;
  }

  .copy p:not(.role):not(.eyebrow) {
    font-size: 1.125rem;
    max-width: 40rem;
  }

  .copy strong {
    color: var(--white);
    background: linear-gradient(transparent 62%, rgba(200, 16, 46, 0.65) 62%);
  }

  .btn-row {
    margin-top: 2rem;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
      align-items: center;
    }
  }

  .stats {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    border-top: 6px solid var(--red);
    padding-top: 1rem;
  }

  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    line-height: 1;
  }

  .stats dt {
    font-weight: 600;
    color: #333;
  }

  @media (min-width: 720px) {
    .stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .credits {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--black);
  }

  .credits li {
    display: grid;
    gap: 0.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid #ddd;
  }

  .org {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    text-transform: uppercase;
    line-height: 1.1;
  }

  .credit-role {
    color: #333;
  }

  @media (min-width: 720px) {
    .credits li {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
    }
  }
</style>
