---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formspreeEndpoint, site } from '../data/site';

const serviceTypes = ['Photography', 'Video', 'Editing'];
const shootTypes = ['Portraits', 'Events', 'Couples', 'Other'];
---

<BaseLayout
  title="Book a Session | DeKalb and Chicago Photographer"
  description="Book portrait, event, or couples photography, video, or editing with EricMcMedia. Serving DeKalb, the Greater Chicago Area, and the Midwest."
>
  <section class="container contact">
    <div class="intro">
      <p class="eyebrow">Contact</p>
      <h1>Book a session</h1>
      <p class="lead">
        Tell me about your shoot and I'll get back to you within two business days with availability and a quote.
      </p>
      <ul class="direct">
        <li>
          <span>Email</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <span>Instagram</span>
          <a href={site.instagram.url} rel="me noopener" target="_blank">
            {site.instagram.handle}<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <span>Based in</span>
          DeKalb, IL. Serving Greater Chicago and the Midwest.
        </li>
      </ul>
    </div>

    <form class="form" action={formspreeEndpoint} method="POST" data-form>
      <input type="hidden" name="_subject" value="New EricMcMedia inquiry" />
      <div class="hp" aria-hidden="true">
        <label>Leave this field empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>

      <div class="row">
        <div class="field">
          <label for="name">Name <span class="req" aria-hidden="true">*</span></label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="email">Email <span class="req" aria-hidden="true">*</span></label>
          <input id="email" name="email" type="email" autocomplete="email" required />
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="phone">Phone <span class="opt">(optional)</span></label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="date">Preferred date</label>
          <input id="date" name="preferred_date" type="date" />
        </div>
      </div>

      <div class="row">
        <div class="field">
          <label for="service">Service type <span class="req" aria-hidden="true">*</span></label>
          <select id="service" name="service" required>
            <option value="">Choose a service</option>
            {serviceTypes.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="shoot">Shoot type</label>
          <select id="shoot" name="shoot_type">
            <option value="">Choose a shoot type</option>
            {shootTypes.map((s) => <option value={s}>{s}</option>)}
          </select>
        </div>
      </div>

      <div class="field">
        <label for="location">Location</label>
        <input id="location" name="location" type="text" placeholder="City or venue" autocomplete="address-level2" />
      </div>

      <div class="field">
        <label for="message">Message <span class="req" aria-hidden="true">*</span></label>
        <textarea id="message" name="message" rows="6" required placeholder="Tell me about your vision, timing, and anything else I should know."
        ></textarea>
      </div>

      <p class="required-note"><span class="req" aria-hidden="true">*</span> Required field</p>

      <button class="btn" type="submit">Send Inquiry</button>
      <p class="status" role="status" aria-live="polite" data-status></p>
    </form>
  </section>
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: 3rem;
    padding-block: clamp(2.5rem, 7vw, 5rem);
  }

  .direct {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .direct li {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .direct li > span:first-child {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--red-text);
    margin-bottom: 0.25rem;
  }

  .direct a {
    font-weight: 700;
    word-break: break-word;
  }

  .form {
    background: var(--surface);
    border-top: 6px solid var(--red);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .row {
    display: grid;
    gap: 0 1.25rem;
  }

  .field {
    margin-bottom: 1.25rem;
  }

  label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .req {
    color: var(--red-text);
  }

  .opt {
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0;
    color: var(--muted);
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    background: var(--black);
    border: 2px solid #555;
    border-radius: 0;
    color: var(--white);
    font: inherit;
    font-size: 1rem;
  }

  input::placeholder,
  textarea::placeholder {
    color: #9a9a9a;
  }

  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--white);
  }

  input:user-invalid,
  select:user-invalid,
  textarea:user-invalid {
    border-color: var(--red-text);
  }

  textarea {
    resize: vertical;
  }

  .hp {
    position: absolute;
    left: -9999px;
  }

  .required-note {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .btn {
    width: 100%;
  }

  .status {
    margin: 1rem 0 0;
    font-weight: 700;
  }

  .status.error {
    color: var(--red-text);
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }

    .btn {
      width: auto;
    }
  }

  @media (min-width: 1000px) {
    .contact {
      grid-template-columns: 4fr 7fr;
      gap: 4rem;
      align-items: start;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = document.querySelector<HTMLElement>('[data-status]');

  if (form && status) {
    // Preselect from links like /contact/?service=Editing
    const params = new URLSearchParams(location.search);
    for (const [param, field] of [
      ['service', 'service'],
      ['shoot', 'shoot_type'],
    ]) {
      const value = params.get(param);
      const select = form.elements.namedItem(field) as HTMLSelectElement | null;
      if (value && select && [...select.options].some((o) => o.value === value)) select.value = value;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      status.className = 'status';
      status.textContent = 'Sending...';

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = "Thanks! Your inquiry is in. I'll be in touch soon.";
      } catch {
        status.classList.add('error');
        status.textContent = 'Something went wrong sending your message. Please email ericmcmedia@gmail.com directly.';
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
